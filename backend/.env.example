# ──────────────────────────────────────────────
# USB Killswitch Backend — Environment Variables
# Copy this to .env and set real values before running.
# ──────────────────────────────────────────────

# JWT secret for signing lease tokens (use a long random string in production)
JWT_SECRET=D*xmp7/UEn7=esImMCxmOz

# Server port
PORT=3000

# Path to the SQLite database file (relative to server.js)
DB_PATH=./data/usb_drives.db

# Admin API key for protected routes (mark-lost, register)
ADMIN_API_KEY=super_secret_admin_key_change_me
