# ============================================================
# Zero-Trust Storage Protection — Backend Configuration
# ============================================================

# Server Port
PORT=3000

# Security Secrets
JWT_SECRET=dev_only_secret_CHANGE_IN_PRODUCTION
ADMIN_API_KEY=dev_admin_key
DB_PATH=./data/usb_drives.db

# ────────────────────────────────────────────────────────────
# Real Google OAuth 2.0 Configuration
# ────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized Redirect URIs:
#    - http://localhost:3000/auth/google/callback (for local dev)
#    - https://securing-storage.onrender.com/auth/google/callback (for production)
# 4. Paste your Client ID and Client Secret below:

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Override redirect URI if behind a custom reverse proxy or domain
# GOOGLE_REDIRECT_URI=https://securing-storage.onrender.com/auth/google/callback
